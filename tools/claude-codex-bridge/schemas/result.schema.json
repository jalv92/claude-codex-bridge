{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "NEEDS_FIXES",
        "NOT_VERIFIABLE"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "priority",
          "title",
          "detail",
          "file",
          "line"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "checks_performed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": [
          "check",
          "result"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "verdict",
    "summary",
    "findings",
    "checks_performed",
    "limitations"
  ],
  "additionalProperties": false
}
