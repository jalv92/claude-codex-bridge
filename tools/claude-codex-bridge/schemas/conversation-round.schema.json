{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "claude_session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100000
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2048,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              }
            },
            "required": [
              "sha256",
              "size"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "round",
    "claude_session_id",
    "message",
    "head",
    "branch",
    "created_at",
    "files"
  ],
  "additionalProperties": false
}
